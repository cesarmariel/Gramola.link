[Unit]
Description=Gramola - servidor de salas del karaoke
After=network.target

[Service]
Type=simple
User=USUARIO
WorkingDirectory=/var/www/vhosts/DOMINIO/app/server
Environment=NODE_ENV=production
Environment=PORT=8877
Environment=HOST=127.0.0.1
Environment=WEB_DIR=/var/www/vhosts/DOMINIO/app/web
Environment=SONGS_DIR=/var/www/vhosts/DOMINIO/app/web/songs
Environment=DATA_DIR=/var/www/vhosts/DOMINIO/app/data
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/var/www/vhosts/DOMINIO/app
ReadWritePaths=/var/www/vhosts/DOMINIO/app/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
